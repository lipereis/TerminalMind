# --- Free path: Google AI Studio (Gemini) ---
# 1. Open https://aistudio.google.com/apikey
# 2. Create API key (free tier)
# 3. Paste key below
OPENAI_API_KEY=your-gemini-api-key
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-latest

# --- Paid/official OpenAI (optional) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# TERMINALMIND_DATA_DIR=/custom/path
# TERMINALMIND_LOG_LEVEL=INFO
# TERMINALMIND_MAX_CONTEXT_CHARS=12000
